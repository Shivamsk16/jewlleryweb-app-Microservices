{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],

    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "moduleResolution": "node",

    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": true,

    "baseUrl": "./src",

    "paths": {
      "@/*": ["*"]
    }
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "prisma"]
}