// JewelFlow — Prisma schema
// Default: SQLite for instant local demo.
// For Production: switch provider to "postgresql" and update DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER") // ADMIN | USER
  createdAt DateTime @default(now())
}

// ============================================================
// VENDOR
// ============================================================
model Vendor {
  id         Int       @id @default(autoincrement())
  name       String
  nameHi     String?
  contact    String?
  phone      String?
  address    String?
  specialty  String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  issues     MaterialIssue[]
  receives   JewelleryReceive[]
}

// ============================================================
// RAW MATERIAL PURCHASE
// ============================================================
model RawMaterialPurchase {
  id            Int      @id @default(autoincrement())
  material      String   // GOLD | SILVER
  purity        String   // "24K","22K","18K","14K","925","999"
  grossWeight   Float
  netWeight     Float
  ratePerGram   Float
  totalAmount   Float
  vendorName    String?
  invoiceNo     String?
  purchaseDate  DateTime @default(now())
  notes         String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ============================================================
// MATERIAL ISSUE (to vendor for production)
// ============================================================
model MaterialIssue {
  id             Int      @id @default(autoincrement())
  vendorId       Int
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  material       String   // GOLD | SILVER
  purity         String
  issuedWeight   Float
  expectedReturn DateTime
  purpose        String?  // Making Order | Sample | Repair
  issueDate      DateTime @default(now())
  status         String   @default("PENDING") // PENDING | RETURNED | OVERDUE
  notes          String?

  receives       JewelleryReceive[]
}

// ============================================================
// JEWELLERY RECEIVE (from vendor)
// ============================================================
model JewelleryReceive {
  id                Int      @id @default(autoincrement())
  vendorId          Int
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  issueId           Int
  issue             MaterialIssue @relation(fields: [issueId], references: [id])
  itemName          String
  grossWeight       Float
  stoneWeight       Float    @default(0)
  netWeight         Float
  wastage           Float
  wastagePercent    Float
  returnedMaterial  Float    @default(0)
  receiveDate       DateTime @default(now())
  qualityRemarks    String?
}

// ============================================================
// NOTIFICATION
// ============================================================
model Notification {
  id         Int      @id @default(autoincrement())
  type       String   // OVERDUE | DUE_SOON | LOW_STOCK | INFO
  title      String
  message    String
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
