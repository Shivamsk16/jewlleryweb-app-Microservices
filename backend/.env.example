# =========================================================
# JewelFlow Backend — Environment Variables
# =========================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Supabase Postgres) ---
# DATABASE_URL = pooled connection (used by the app at runtime).
# In Supabase, this is the "Connection pooling" string. The pooler runs on
# port 6543 in the standard Supabase setup — replace 5432 with 6543 if you
# are using the Transaction/Session pooler.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"

# DIRECT_URL = direct connection (used by Prisma for migrations & introspection).
# This must NOT go through pgbouncer. In Supabase, this is the "Connection
# string > URI" value (port 5432).
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase Service Keys ---
# Used by the @supabase/supabase-js client (e.g. for Storage, Auth admin
# operations, RLS-bypassing queries). The service_role key is sensitive —
# never ship it to the browser.
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"

# --- Auth ---
JWT_SECRET="please-change-me-in-production-jewelflow-secret-key"
JWT_EXPIRES_IN="30m"

# --- CORS ---
FRONTEND_URL="http://localhost:3000"

# --- Cookies ---
# In dev (localhost), set to "localhost" so the cookie set by :4000 is also
# visible to :3000. In production, use ".yourdomain.com".
COOKIE_DOMAIN="localhost"
