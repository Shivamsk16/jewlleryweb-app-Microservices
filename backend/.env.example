# =========================================================
# JewelFlow Backend — Environment Variables
# =========================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Default: SQLite for instant local demo
DATABASE_URL="file:./dev.db"
# For PostgreSQL: switch provider in prisma/schema.prisma to "postgresql"
# DATABASE_URL="postgresql://user:password@localhost:5432/jewelflow?schema=public"

# --- Auth ---
JWT_SECRET="please-change-me-in-production-jewelflow-secret-key"
JWT_EXPIRES_IN="30m"

# --- CORS ---
# The origin of the Next.js frontend. Used for CORS allow-list and cookie domain.
FRONTEND_URL="http://localhost:3000"

# --- Cookies ---
# In dev (localhost), set to "localhost" so the cookie set by :4000 is also
# visible to :3000. In production, use ".yourdomain.com" so it's shared between
# api.yourdomain.com and app.yourdomain.com.
COOKIE_DOMAIN="localhost"
